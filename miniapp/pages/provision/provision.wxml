<view class="page">
  <view class="intro">
    <view class="row-between">
      <text class="intro-title">设备配网</text>
      <text class="ver-badge">小程序 v{{appVersion}}</text>
    </view>
    <text class="intro-sub">扫描并连接 ESP32 · 绑定保护板 · 配置 WiFi</text>
    <text wx:if="{{pongOk}}" class="pong-ok">✓ 已收到设备 PONG · 通信正常</text>
    <text wx:elif="{{bleReady}}" class="pong-wait">… 等待设备 PONG（超时将主动读取）</text>
    <text wx:if="{{linkStat}}" class="link-stat">采集链路 · {{linkStat}}</text>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">步骤 1 · 连接设备</text>
      <text wx:if="{{bleReady}}" class="tag ok">已连接</text>
    </view>
    <button wx:if="{{!bleReady}}" class="primary" bindtap="startScan" loading="{{scanning}}">扫描 JKBMS 设备</button>
    <view wx:if="{{status && !bleReady}}" class="hint">{{status}}</view>
    <view wx:if="{{devices.length && !bleReady}}" class="dev-list">
      <view wx:for="{{devices}}" wx:key="deviceId" class="dev-item {{item.isTarget ? 'dev-target' : ''}}" bindtap="connectDevice" data-deviceid="{{item.deviceId}}" data-name="{{item.name}}">
        <text class="dev-name">{{item.isJk ? '★ ' : (item.isNear ? '◇ ' : '')}}{{item.name}}</text>
        <text class="dev-rssi">{{item.rssi}} dBm</text>
      </view>
    </view>
    <view wx:if="{{!bleReady && !scanning && !devices.length}}" class="hint">扫不到时请确认：① 手机蓝牙已开 ② 已授予微信定位权限（Android 必需）③ ESP32 已上电且刚烧录成功</view>
    <view wx:if="{{bleReady}}" class="connected">{{connectedName}}</view>
  </view>

  <block wx:if="{{bleReady}}">
    <view class="card">
      <view class="row-between">
        <text class="card-title">步骤 2 · 绑定保护板</text>
        <button class="mini" bindtap="scanBms">让设备扫描</button>
      </view>
      <view class="hint">三种方式选 MAC（按 MAC 精确直连，不依赖设备扫描）：① 下方「手机扫到的设备」点选（推荐）② 手动填序列号/MAC ③ 设备扫描结果</view>

      <!-- 方式①：手机步骤1扫到的设备，deviceId 即 BLE MAC（极空板广播名常是序列号） -->
      <view wx:if="{{devices.length}}" class="sub-title">手机扫到的设备（点选MAC）</view>
      <view wx:if="{{devices.length}}" class="dev-list">
        <view wx:for="{{devices}}" wx:key="deviceId" class="dev-item {{selectedMac===item.deviceId?'dev-target':''}}" bindtap="bindFromPhone" data-mac="{{item.deviceId}}">
          <text class="dev-name">{{item.rssi >= -70 ? '◇ ' : ''}}{{item.name}}</text>
          <text class="bms-mac">{{item.deviceId}}</text>
        </view>
      </view>

      <!-- 方式②：手动填 MAC（必须标准格式，序列号不能直连） -->
      <view class="sub-title">手动填 MAC（须 AA:BB:CC:DD:EE:FF 格式）</view>
      <view class="mac-row">
        <input class="field mac-input" placeholder="序列号仅用于在上方认设备，此处填MAC" value="{{manualMac}}" bindinput="onManualMac"/>
        <button class="mini" bindtap="bindManualMac">填入</button>
      </view>

      <!-- 方式③：设备端扫描结果 -->
      <view wx:if="{{bmsList.length}}" class="sub-title">设备扫描结果</view>
      <view wx:if="{{bmsList.length}}" class="bms-list">
        <view wx:for="{{bmsList}}" wx:key="mac" class="bms-item {{selectedMac===item.mac?'selected':''}}" bindtap="selectBms" data-mac="{{item.mac}}">
          <view class="bms-info">
            <text class="bms-name">{{item.name}}</text>
            <text class="bms-mac">{{item.mac}}</text>
          </view>
          <text class="bms-rssi">{{item.rssi}} dBm</text>
        </view>
      </view>

      <view wx:if="{{selectedMac}}" class="selected-line">待绑定 MAC：{{selectedMac}}</view>
      <button class="secondary" bindtap="saveBms">确认绑定到设备</button>
      <view class="hint">绑定后点底部「保存并重启」，ESP32 会按此 MAC 直连保护板采集数据。</view>
    </view>

    <view class="card">
      <text class="card-title">步骤 3 · WiFi 配置</text>
      <input class="field" placeholder="WiFi 名称 (SSID)" value="{{wifiSsid}}" bindinput="onSsidInput"/>
      <input class="field" placeholder="WiFi 密码" password value="{{wifiPass}}" bindinput="onPassInput"/>
      <button class="secondary" bindtap="saveWifi">保存 WiFi</button>
    </view>

    <view class="card">
      <text class="card-title">步骤 4 · 设备 ID（可选）</text>
      <input class="field" placeholder="上报设备ID" value="{{deviceId}}" bindinput="onIdInput"/>
      <button class="secondary" bindtap="saveId">保存设备ID</button>
      <button class="mini ghost" bindtap="loadCfg">读取当前配置</button>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="card-title">步骤 5 · 涂鸦智能（可选）</text>
        <text class="hint">{{tuyaStatus || '未配置'}}</text>
      </view>
      <view class="hint">开启后数据同时上报涂鸦云，可在「智能生活」App 里查看并做场景联动。需先在涂鸦平台创建产品、定义 DP 点、添加设备获得三元组（详见 TUYA-SETUP.md）。</view>
      <input class="field" placeholder="Product ID (PID)" value="{{tuyaPid}}" bindinput="onTuyaPid"/>
      <input class="field" placeholder="Device ID" value="{{tuyaDevId}}" bindinput="onTuyaDevId"/>
      <input class="field" password placeholder="Device Secret（密钥，仅存设备本地）" value="{{tuyaSecret}}" bindinput="onTuyaSecret"/>
      <view class="mac-row">
        <text class="hint">区域：</text>
        <picker mode="selector" range="{{['0 中国','1 美西','2 中欧','3 美东','4 西欧','5 印度','6 新加坡']}}" value="{{tuyaRegion}}" bindchange="onTuyaRegion">
          <view class="picker-btn">{{tuyaRegion}} · 点此选择</view>
        </picker>
      </view>
      <button class="secondary" bindtap="saveTuya">启用涂鸦上报</button>
      <button class="mini ghost" bindtap="turnOffTuya">关闭涂鸦上报</button>
    </view>

    <button class="primary apply" bindtap="applyAndReboot">保存并重启设备</button>
    <button class="danger-btn" bindtap="factoryReset">恢复出厂设置</button>
  </block>

  <view class="card log-card">
    <view class="row-between">
      <text class="card-title">日志（可复制反馈）</text>
      <button class="mini" bindtap="copyLogs">复制日志</button>
    </view>
    <view class="log">
      <view wx:for="{{log}}" wx:key="index" class="log-line" user-select>{{item}}</view>
    </view>
  </view>
</view>
