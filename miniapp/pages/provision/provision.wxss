.page { padding: 24rpx 0 60rpx; }
.intro { padding: 8rpx 32rpx 24rpx; }
.intro-title { display: block; font-size: 36rpx; font-weight: 500; color: #1f2329; }
.intro-sub { display: block; font-size: 24rpx; color: #8a8f99; margin-top: 8rpx; }
.ver-badge { font-size: 22rpx; color: #185fa5; background: #e6f1fb; padding: 6rpx 14rpx; border-radius: 20rpx; }
.pong-ok { display: block; font-size: 24rpx; color: #0f6e56; margin-top: 12rpx; }
.pong-wait { display: block; font-size: 24rpx; color: #b8860b; margin-top: 12rpx; }
.link-stat { display: block; font-size: 23rpx; color: #4361aa; margin-top: 8rpx; }
.card { margin: 0 24rpx 24rpx; padding: 28rpx; background: #ffffff; border-radius: 16rpx; }
.card-title { font-size: 28rpx; font-weight: 500; color: #1f2329; }
.row-between { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.tag { font-size: 22rpx; color: #185fa5; background: #e6f1fb; padding: 6rpx 14rpx; border-radius: 20rpx; }
.tag.ok { color: #0f6e56; background: #e1f5ee; }
.primary { margin: 8rpx 0; background: #185fa5; color: #ffffff; font-size: 28rpx; border-radius: 12rpx; }
.primary.apply { margin: 16rpx 24rpx; }
.secondary { margin: 16rpx 0 0; background: #e6f1fb; color: #185fa5; font-size: 26rpx; border-radius: 12rpx; }
.mini { font-size: 22rpx; color: #185fa5; background: #e6f1fb; padding: 8rpx 18rpx; border-radius: 16rpx; line-height: 1.4; }
.mini.ghost { background: #f5f7fa; color: #5f5e5a; margin-top: 16rpx; }
.danger-btn { margin: 8rpx 24rpx; background: #ffffff; color: #a32d2d; font-size: 26rpx; border: 1rpx solid #f09595; border-radius: 12rpx; }
.dev-list, .bms-list { margin-top: 12rpx; }
.dev-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #f5f7fa; border-radius: 12rpx; margin-bottom: 12rpx; }
.dev-item.dev-target { background: #e1f5ee; border: 2rpx solid #1d9e75; }
.dev-name { font-size: 26rpx; color: #1f2329; }
.dev-rssi, .bms-rssi { font-size: 22rpx; color: #8a8f99; }
.connected { font-size: 28rpx; color: #0f6e56; background: #e1f5ee; padding: 20rpx; border-radius: 12rpx; }
.bms-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #f5f7fa; border-radius: 12rpx; margin-bottom: 12rpx; border: 2rpx solid transparent; }
.bms-item.selected { background: #e1f5ee; border-color: #1d9e75; }
.bms-name { display: block; font-size: 26rpx; color: #1f2329; }
.bms-mac { display: block; font-size: 22rpx; color: #8a8f99; margin-top: 4rpx; }
.hint { font-size: 24rpx; color: #8a8f99; line-height: 1.6; margin-top: 12rpx; }
.sub-title { font-size: 24rpx; color: #185fa5; font-weight: 500; margin-top: 20rpx; margin-bottom: 8rpx; }
.mac-row { display: flex; align-items: center; gap: 12rpx; }
.mac-input { flex: 1; margin-top: 0; }
.picker-btn { font-size: 26rpx; color: #185fa5; background: #e6f1fb; padding: 12rpx 20rpx; border-radius: 10rpx; margin-top: 16rpx; }
.selected-line { font-size: 24rpx; color: #0f6e56; margin-top: 16rpx; }
.field { font-size: 26rpx; padding: 20rpx; background: #f5f7fa; border-radius: 12rpx; margin-top: 16rpx; }
.log-card { margin-top: 8rpx; }
.log { margin-top: 16rpx; max-height: 400rpx; overflow-y: auto; }
.log-line { font-size: 22rpx; color: #5f5e5a; line-height: 1.8; font-family: monospace; }
