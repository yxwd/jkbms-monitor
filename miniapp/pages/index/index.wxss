.page { padding: 24rpx 0 60rpx; }
.head { display: flex; justify-content: space-between; padding: 8rpx 32rpx 20rpx; }
.device { font-size: 24rpx; color: #5f5e5a; }
.updated { font-size: 22rpx; color: #8a8f99; }
.state { text-align: center; color: #8a8f99; font-size: 26rpx; }
.tag { font-size: 22rpx; color: #185fa5; background: #e6f1fb; padding: 6rpx 14rpx; border-radius: 20rpx; }
.soc-row { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.soc-num { font-size: 72rpx; font-weight: 500; color: #1f2329; }
.unit { font-size: 28rpx; color: #8a8f99; margin-left: 6rpx; }
.bar { height: 14rpx; background: #eef0f2; border-radius: 8rpx; overflow: hidden; margin-bottom: 20rpx; }
.bar-fill { height: 100%; background: #1d9e75; border-radius: 8rpx; }
.alarm { margin-top: 18rpx; font-size: 26rpx; padding: 16rpx; border-radius: 12rpx; background: #f7f8fa; }
.cell-grid { display: flex; flex-wrap: wrap; }
.cell { width: 25%; box-sizing: border-box; padding: 10rpx; text-align: center; }
.cell-no { display: block; font-size: 20rpx; color: #8a8f99; }
.cell-v { display: block; font-size: 26rpx; margin-top: 4rpx; }
.cell-min { background: #fcebee; border-radius: 10rpx; }
.cell-min .cell-v { color: #a32d2d; }
.cell-max { background: #e1f5ee; border-radius: 10rpx; }
.cell-max .cell-v { color: #0f6e56; }
.legend { margin-top: 18rpx; font-size: 22rpx; color: #8a8f99; }
.dot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; margin: 0 8rpx 0 16rpx; }
.dot.min { background: #e24b4a; }
.dot.max { background: #1d9e75; }
.primary { margin: 8rpx 32rpx; background: #185fa5; color: #ffffff; font-size: 28rpx; }
.secondary { margin: 8rpx 32rpx; background: #e6f1fb; color: #185fa5; font-size: 28rpx; }
