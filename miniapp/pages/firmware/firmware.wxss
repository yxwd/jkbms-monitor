.page { padding: 24rpx; background: #f5f7fa; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.title { font-size: 30rpx; font-weight: 500; color: #1a1a1a; margin-bottom: 20rpx; }
.state { color: #888; font-size: 26rpx; padding: 20rpx 0; }
.danger { color: #e24b4a; }
.ver { border-top: 1rpx solid #eee; padding: 20rpx 0; }
.ver-head { display: flex; align-items: center; justify-content: space-between; }
.ver-num { font-size: 30rpx; font-weight: 500; color: #1a1a1a; }
.tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.tag.on { background: #e8f5ee; color: #1d9e75; }
.tag.off { background: #f0f0f0; color: #888; }
.meta { font-size: 24rpx; color: #888; margin-top: 10rpx; }
.url { font-size: 24rpx; color: #2b7cff; margin-top: 10rpx; word-break: break-all; }
.actions { margin-top: 16rpx; display: flex; }
.mini { font-size: 24rpx; margin-right: 16rpx; }
.tip { font-size: 24rpx; color: #a06a00; background: #fff8e6; padding: 16rpx; border-radius: 10rpx; margin-bottom: 20rpx; line-height: 1.6; }
.field { margin-bottom: 20rpx; }
.field.two { display: flex; }
.half { flex: 1; margin-right: 12rpx; }
.half:last-child { margin-right: 0; }
.label { display: block; font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
input, textarea { width: 100%; box-sizing: border-box; background: #f7f8fa; border: 1rpx solid #e5e7eb; border-radius: 10rpx; padding: 16rpx; font-size: 26rpx; color: #1a1a1a; }
textarea { min-height: 80rpx; }
.choose { background: #eef4ff; color: #2b7cff; font-size: 26rpx; margin-bottom: 12rpx; }
.file { font-size: 24rpx; color: #1d9e75; margin-bottom: 20rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; font-size: 26rpx; color: #333; }
.primary { background: #2b7cff; color: #fff; font-size: 28rpx; margin-top: 20rpx; border-radius: 12rpx; }
